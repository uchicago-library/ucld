{#
  Base layout for documentation pages.

  Reproduces the page chain that documentation pages previously hand-rolled,
  so a page can be authored as either .html or .md and render identically.

  Front matter:
    title       — required; renders as the <h1> and in the <title> tag
    description — optional; renders as the lead paragraph and the meta description

  Note: meta/document-start.html opens through <body> without closing it, and
  footer.html chains meta/document-end.html, which closes </body></html>.
#}
{% include "meta/document-start.html" %}
{% include "meta/docs-header.html" %}

{% include "breadcrumb.html" %}

<main id="main-content" tabindex="-1" class="container-md py-5 mb-5">
  <div class="row">
    <div class="col-lg-10 mx-auto documentation">

      <h1>{{ title }}</h1>
      {% if description %}
      <p class="lead">{{ description }}</p>
      {% endif %}

      {{ content | safe }}

    </div>
  </div>
</main>

{% include "footer.html" %}
